<?xml version="1.0" encoding="utf-8"?>
<!--
  白い熊 速記 adaptive launcher icon (Android 8.0+ / API 26+).
  A solid black background + the yellow traced-X foreground, drawn from a vector so it stays
  sharp at any launcher size. Includes <monochrome> for Material You themed icons (Android 13+).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_sk_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_sk_monochrome" />
</adaptive-icon>

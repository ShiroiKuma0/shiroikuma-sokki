<?xml version="1.0" encoding="utf-8"?>
<!--
  白い熊 速記 launch animation — frame-by-frame AnimationDrawable, 24 frames @ 67ms = ~1.6s loop.

  The mark is *written* rather than revealed: the launcher icon's own two brush strokes are laid
  down one after the other (0-7, then 8-14), held (15-20), then dimmed (21-23) so the loop's wrap
  is not a hard cut. A handwriting app's splash showing a pen writing is the honest animation, and
  reusing the icon's geometry is what keeps splash and launcher the same mark.

  Frames are generated, not drawn: tools/icon/emit_loader.py, off the same model as the icon.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/xnotes_frame_00" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_01" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_02" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_03" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_04" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_05" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_06" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_07" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_08" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_09" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_10" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_11" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_12" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_13" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_14" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_15" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_16" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_17" android:duration="67" />
    <item android:drawable="@drawable/xnotes_frame_18" android:duration="67" />

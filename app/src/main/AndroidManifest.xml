<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The 保存復元 automation export runs on a foreground service: a manifest receiver cannot
         hold it without risking an ANR inside Android's broadcast window. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The infinite canvas renders on GLES 3.0. Not required: the paged notebook does not use
         it, so a device without it keeps the rest of the app. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <!-- Without this our reply broadcast's setPackage() fails SILENTLY on Android 11+: the export
         runs, writes correctly, and is never heard of. BOTH callers, always — 自由作業盤 drives the
         保存復元 batch (§1) and 応用管理 drives the data door (§2a). This element was entirely absent
         from this fork's manifest until the v2 rollout, so every §1 reply it has ever sent was
         discarded. Adding a third caller is one line here; QUERY_ALL_PACKAGES buys nothing. -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xnotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Xnotes.Splash"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" a PDF from a file manager: import it into a new note. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- "Share" a PDF to xnotes: same import. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The 保存復元 sister-app contract, §1. No android:permission: in v2 this receiver is the
             UNAUTHENTICATED half of the surface, deliberately — it only ever writes where it was
             told to and reports what it did. Everything that moves data through a caller-supplied
             descriptor lives behind the provider below, which knows who is calling. The cancel
             action is on this same exported receiver because the service is not exported and a
             third-party app therefore cannot reach it directly. -->
        <receiver
            android:name=".automation.StateExportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="shiroikuma.sokki.action.EXPORT_STATE" />
                <action android:name="shiroikuma.sokki.action.LIST_CATEGORIES" />
                <action android:name="shiroikuma.sokki.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".automation.StateExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- §2a, the data door: 応用管理 backs this app up WITH its data and puts it back on a
             wiped phone. Exported with no android:permission for a real reason — a custom
             permission would have to be `normal` (any app may hold it) or `signature` (impossible:
             every app in this family has its own keystore). The caller is identified instead, three
             ways, in automation/AutomationCallers.kt. `import` exists ONLY here: an import
             overwrites the app's data, and the receiver above is exported without a permission. -->
        <provider
            android:name=".automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true" />

        <service
            android:name=".automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation data export/import" />
        </service>

        <!-- Capability discovery. Read with MATCH_UNINSTALLED_PACKAGES|MATCH_DISABLED_COMPONENTS,
             so 応用管理 can answer "can this app be backed up" for an app 白い熊 has frozen —
             a frozen app cannot be asked anything, which is why this is not a query intent. -->
        <meta-data android:name="shiroikuma.automation.contract" android:value="2" />
        <meta-data android:name="shiroikuma.automation.format" android:value="1" />
        <meta-data android:name="shiroikuma.automation.min_format" android:value="1" />

        <provider
            android:name=".platform.AppStorageDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
    </application>

</manifest>
